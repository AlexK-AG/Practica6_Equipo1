[sub_resource type="Shader" id="Shader_stasis_cloud"]
code = "shader_type canvas_item;

uniform vec3 cloud_color = vec3(0.23, 0.54, 0.98);
uniform float cloud_opacity = 0.17;
uniform float cloud_size = 0.29;

float hash_value(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise_value(vec2 p) {
	vec2 cell = floor(p);
	vec2 local = fract(p);
	local = local * local * (3.0 - 2.0 * local);
	float a = hash_value(cell);
	float b = hash_value(cell + vec2(1.0, 0.0));
	float c = hash_value(cell + vec2(0.0, 1.0));
	float d = hash_value(cell + vec2(1.0, 1.0));
	return mix(mix(a, b, local.x), mix(c, d, local.x), local.y);
}

float cloud_noise(vec2 p) {
	float value = 0.0;
	float amplitude = 0.5;
	for (int octave = 0; octave < 3; octave++) {
		value += noise_value(p) * amplitude;
		p = p * 2.03 + vec2(13.1, 7.7);
		amplitude *= 0.5;
	}
	return value;
}

void fragment() {
	float edge = min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y));
	float edge_fog = 1.0 - smoothstep(0.01, cloud_size, edge);
	float clouds = cloud_noise(UV * vec2(9.0, 5.0) + vec2(TIME * 0.08, -TIME * 0.05));
	float alpha = edge_fog * mix(0.55, 1.0, clouds) * cloud_opacity;
	COLOR = vec4(cloud_color, alpha);
}"

